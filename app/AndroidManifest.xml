<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mmunki.dlss5"
    android:versionCode="3"
    android:versionName="2.0.1">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />

    <!-- Needed on Android 11+ to list the user apps the picker shows. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- The DLSS5 game HUD is a TYPE_APPLICATION_OVERLAY window; the user
         grants it explicitly from the main screen. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".GameTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_off"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
